# Employee Portal Security Hardening

# Block access to sensitive files
# <FilesMatch "\.(log|ps1|sql|bak|tar|gz|zip|env|json|lock|ssh|key|rsa)$">
#    Order deny,allow
#    Deny from all
# </FilesMatch>

# Block specific high-risk files
<Files "wp-config.php">
    Order deny,allow
    Deny from all
</Files>
<Files "xmlrpc.php">
    Order deny,allow
    Deny from all
</Files>

# Disable directory browsing
Options -Indexes

# Prevent execution of PHP in uploads (assuming standard WP structure)
# This part is usually placed in wp-content/uploads/.htaccess
