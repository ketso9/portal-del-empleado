# Employee Portal Security Hardening

# Block access to sensitive files
<FilesMatch "\.(log|ps1|sh|sql|bak|tar|gz|zip|env|json|lock|ssh|key|rsa)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block specific high-risk files
<Files "wp-config.php">
    Order deny,allow
    Deny from all
</Files>
<Files "xmlrpc.php">
    Order deny,allow
    Deny from all
</Files>

# Disable directory browsing
Options -Indexes

# Prevent execution of PHP in uploads (assuming standard WP structure)
# This part is usually placed in wp-content/uploads/.htaccess
